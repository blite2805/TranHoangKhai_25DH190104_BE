@model TranHoangKhai_25DH190104_BE.Models.Category
@{
    ViewBag.Title = "Chi tiết danh mục";
    var productCount = Model.Products != null ? Model.Products.Count : 0;
}
<div class="panel">
    <p><b>Mã:</b> @Model.CategoryID</p>
    <p><b>Tên danh mục:</b> @Model.CategoryName</p>
    <p><b>Số sản phẩm:</b> @productCount</p>
</div>
<a class="btn o" href="@Url.Action("Index")">Quay lại</a>
<a class="btn o" href="@Url.Action("Edit", new { id = Model.CategoryID })">Sửa</a>