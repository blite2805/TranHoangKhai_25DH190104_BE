@model TranHoangKhai_25DH190104_BE.Models.Product
@using (Html.BeginForm(ViewContext.RouteData.Values["action"].ToString(), "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "err" })
    @Html.HiddenFor(m => m.ProductID)
    <div class="f">
        <label>Tên sản phẩm * @Html.EditorFor(m => m.ProductName, new { htmlAttributes = new { @class = "form-control" } }) @Html.ValidationMessageFor(m => m.ProductName, "", new { @class = "err" })</label>
        <label>Danh mục @Html.DropDownList("CategoryID", null, htmlAttributes: new { @class = "form-control" })</label>
        <label>Giá (đồng) * @Html.EditorFor(m => m.ProductPrice, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0" } }) @Html.ValidationMessageFor(m => m.ProductPrice, "", new { @class = "err" })</label>
        <label>Mô tả @Html.TextAreaFor(m => m.ProductDecription, new { @class = "form-control", rows = 3 })</label>
        <label>Ảnh sản phẩm (upload lên ~/Content/images) <input type="file" name="UploadImg" accept="image/*"></label>
        @if (!string.IsNullOrEmpty(Model.ProductImage)) { <label>Ảnh hiện tại: <img src="@Model.ProductImage" style="max-height:80px"></label> }
        <button type="submit" class="btn">Lưu</button>
    </div>
}
