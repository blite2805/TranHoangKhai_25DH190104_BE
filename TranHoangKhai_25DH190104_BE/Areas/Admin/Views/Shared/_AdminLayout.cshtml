<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>@ViewBag.Title - Admin</title>
<style>
*{box-sizing:border-box}
body{margin:0;font:15px/1.5 "Segoe UI",system-ui,Arial,sans-serif;background:#f4f6fb;color:#16203a;display:flex;min-height:100vh}
aside{width:220px;background:#16203a;color:#fff;padding:18px 0;flex-shrink:0}
aside h2{font-size:16px;margin:0 16px 18px;letter-spacing:.5px}
aside a{display:block;color:#ffffffcc;text-decoration:none;padding:10px 18px}
aside a:hover,aside a.on{background:#0a8f86;color:#fff}
main{flex:1;padding:24px;max-width:100%;overflow-x:auto}
.topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:10px}
.topbar b{font-size:20px}
.btn{cursor:pointer;border:0;border-radius:8px;padding:8px 14px;background:#0a8f86;color:#fff;font-weight:700;text-decoration:none;display:inline-block;font:inherit}
.btn.r{background:#d6336c}.btn.o{background:#fff;color:#16203a;border:1px solid #dfe4ef}
.panel{background:#fff;border:1px solid #dfe4ef;border-radius:12px;padding:16px;margin-bottom:16px}
table{width:100%;border-collapse:collapse;font-size:14px;background:#fff}
th,td{text-align:left;padding:9px 8px;border-bottom:1px solid #dfe4ef;vertical-align:top}
th{color:#5f6b85;font-weight:600;background:#fafbfe}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px;margin-bottom:16px}
.kpi{background:#fff;border:1px solid #dfe4ef;border-radius:12px;padding:14px}.kpi b{display:block;font-size:24px;color:#0a8f86}
input,select,textarea{font:inherit;padding:8px 12px;border-radius:8px;border:1px solid #dfe4ef;background:#fff}
.f{display:grid;gap:10px;max-width:480px}.f label{font-size:13px;color:#5f6b85;display:grid;gap:4px}.f input,.f select,.f textarea{width:100%}
.err{color:#d6336c;font-size:13px}
h1,h2,h3{margin-top:0}
.pg{display:flex;gap:6px;justify-content:center;margin-top:16px;flex-wrap:wrap}
.pg a{background:#fff;color:#16203a;border:1px solid #dfe4ef;border-radius:8px;padding:6px 12px;text-decoration:none}.pg a.active{background:#0a8f86;color:#fff}
</style>
</head>
<body>
<aside>
 <h2>QUẢN TRỊ</h2>
 <a href="@Url.Action("Index","Home",new{area="Admin"})" class="@(ViewContext.RouteData.Values["controller"].ToString()=="Home"?"on":"")">📊 Thống kê</a>
 <a href="@Url.Action("Index","Categories",new{area="Admin"})" class="@(ViewContext.RouteData.Values["controller"].ToString()=="Categories"?"on":"")">📁 Danh mục</a>
 <a href="@Url.Action("Index","Products",new{area="Admin"})" class="@(ViewContext.RouteData.Values["controller"].ToString()=="Products"?"on":"")">📦 Sản phẩm</a>
 <a href="@Url.Action("Index","Customers",new{area="Admin"})" class="@(ViewContext.RouteData.Values["controller"].ToString()=="Customers"?"on":"")">👥 Khách hàng</a>
 <a href="@Url.Action("Index","Admins",new{area="Admin"})" class="@(ViewContext.RouteData.Values["controller"].ToString()=="Admins"?"on":"")">🔑 Tài khoản Admin</a>
 <a href="@Url.Action("Index","Home",new{area=""})">🌐 Xem cửa hàng</a>
 <a href="@Url.Action("Logout","Account",new{area=""})">🚪 Đăng xuất</a>
</aside>
<main>
 <div class="topbar"><b>@ViewBag.Title</b><span>Admin: @User.Identity.Name</span></div>
 @RenderBody()
</main>
@RenderSection("scripts", required: false)
</body>
</html>
