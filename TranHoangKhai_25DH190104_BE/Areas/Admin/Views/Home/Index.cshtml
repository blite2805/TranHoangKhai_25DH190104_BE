@using System.Collections.Generic
@{
    ViewBag.Title = "Thống kê";
    var topNames = new List<string>();
    var topQtys = new List<int>();
    if (ViewBag.Top != null)
    {
        foreach (var t in ViewBag.Top)
        {
            var type = t.GetType();
            var nameProp = type.GetProperty("name") ?? type.GetProperty("Name");
            var qtyProp = type.GetProperty("qty") ?? type.GetProperty("Qty");
            var pName = nameProp != null ? (Convert.ToString(nameProp.GetValue(t, null)) ?? "") : "";
            var pQty = qtyProp != null ? Convert.ToInt32(qtyProp.GetValue(t, null)) : 0;
            topNames.Add(pName);
            topQtys.Add(pQty);
        }
    }
}
<div class="kpis">
    <div class="kpi">Khách hàng<b>@ViewBag.Customers</b></div>
    <div class="kpi">Đơn hàng<b>@ViewBag.Orders</b></div>
    <div class="kpi">Doanh thu<b>@(((decimal)ViewBag.Revenue).ToString("N0")) đ</b></div>
    <div class="kpi">Sản phẩm<b>@ViewBag.Products</b></div>
</div>
<div class="panel"><b>Doanh thu 7 ngày gần nhất</b><div id="chart" style="height:260px;margin-top:10px"></div></div>
<div class="panel">
    <b>Sản phẩm bán chạy</b>
    <ol>
        @for (int i = 0; i < topNames.Count; i++)
        {
            <li>@topNames[i] - @topQtys[i] sản phẩm</li>
        }
    </ol>
</div>
<div class="panel">
    <b>Biểu đồ tỷ lệ sản phẩm bán chạy</b>
    <div id="piechart" style="height:300px;margin-top:10px"></div>
</div>
@section scripts {
    <script type="text/javascript" src="https://www.gstatic.com/charts/loader.js"></script>
    <script type="text/javascript">
        google.charts.load('current', { packages: ['corechart'] });
        google.charts.setOnLoadCallback(draw);
        function draw() {
            var data = new google.visualization.DataTable();
            data.addColumn('string', 'Ngày'); data.addColumn('number', 'Doanh thu');
            var labels = [@Html.Raw(ViewBag.RevLabels)]; var vals = [@Html.Raw(ViewBag.RevValues)];
            for (var i = 0; i < labels.length; i++) data.addRow([labels[i], vals[i]]);
            new google.visualization.ColumnChart(document.getElementById('chart'))
                .draw(data, { legend: { position: 'none' }, colors: ['#0a8f86'], hAxis: { slantedText: true }, vAxis: { minValue: 0 } });

            var pNames = @Html.Raw(System.Web.Helpers.Json.Encode(topNames));
            var pQtys = @Html.Raw(System.Web.Helpers.Json.Encode(topQtys));
            if (pNames && pNames.length > 0) {
                var pieData = new google.visualization.DataTable();
                pieData.addColumn('string', 'Sản phẩm');
                pieData.addColumn('number', 'Số lượng');
                for (var j = 0; j < pNames.length; j++) {
                    pieData.addRow([pNames[j], pQtys[j]]);
                }
                new google.visualization.PieChart(document.getElementById('piechart'))
                    .draw(pieData, {
                        colors: ['#0a8f86', '#ff6b35', '#3b82f6', '#f59e0b', '#8b5cf6'],
                        chartArea: { width: '90%', height: '82%' }
                    });
            }
        }
        window.addEventListener('resize', draw);
    </script>
}