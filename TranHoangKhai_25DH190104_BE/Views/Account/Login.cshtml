@model TranHoangKhai_25DH190104_BE.Models.ViewModel.LoginVM
@{ ViewBag.Title = "Đăng nhập"; }
<div class="panel" style="max-width:480px;margin:auto">
 <h2>Đăng nhập</h2>
 @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "f" }))
 {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "err" })
    <label>Tên đăng nhập @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })</label>
    <label>Mật khẩu @Html.PasswordFor(m => m.Password, new { @class = "form-control" })</label>
    <label style="display:flex;gap:8px;align-items:center">@Html.CheckBoxFor(m => m.RememberMe) Ghi nhớ đăng nhập</label>
    <button type="submit">Đăng nhập</button>
    <a href="@Url.Action("Register","Account")" style="color:var(--teal)">Chưa có tài khoản? Đăng ký</a>
    <span class="mu">Admin mẫu: admin / Admin@123</span>
 }
</div>
