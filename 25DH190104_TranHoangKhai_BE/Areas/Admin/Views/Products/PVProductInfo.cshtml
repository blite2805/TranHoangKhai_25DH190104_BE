@model _25DH190104_TranHoangKhai_BE.Models.Product

<div class="row">

    <div class="col-md-4 text-center">

        <img src="@Url.Content(string.IsNullOrEmpty(Model.ProductImage) ? "https://picsum.photos/seed/" + Model.ProductID + "/400/300" : Model.ProductImage)"
             class="img-thumbnail"
             style="width:200px; height:200px; object-fit:cover;"
             alt="@Model.ProductName" />

    </div>

    <div class="col-md-8">

        <dl class="dl-horizontal">

            <dt>Danh mục</dt>
            <dd>@Model.Category.CategoryName</dd>

            <dt>Tên sản phẩm</dt>
            <dd>
                <strong>@Model.ProductName</strong>
            </dd>

            <dt>Mô tả</dt>
            <dd>@Model.ProductDescription</dd>

            <dt>Giá</dt>
            <dd>
                <strong>@Model.ProductPrice.ToString("N0") VNĐ</strong>
            </dd>

        </dl>

    </div>

</div>