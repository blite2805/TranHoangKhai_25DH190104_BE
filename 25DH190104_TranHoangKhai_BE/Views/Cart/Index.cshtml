@model List<_25DH190104_TranHoangKhai_BE.Models.CartItem>
@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    // Nhóm sản phẩm theo CategoryName (CartItem đã có CategoryID/CategoryName theo spec Phần 3)
    var grouped = (Model ?? new List<_25DH190104_TranHoangKhai_BE.Models.CartItem>())
        .GroupBy(i => string.IsNullOrEmpty(i.CategoryName) ? "Khác" : i.CategoryName)
        .ToList();
    decimal totalAmount = Model != null ? Model.Sum(i => i.TotalPrice) : 0;
    string ImgUrl(string productImage, int productId)
    {
        if (string.IsNullOrEmpty(productImage)) return Url.Content("~/Content/Images/shopping.webp");
        if (productImage.StartsWith("http")) return productImage;
        return Url.Content("~/Content/Images/" + productImage);
    }
}
<div class="container mt-4 mb-5">
    <h2 class="mb-4"><i class="fas fa-shopping-cart"></i> Giỏ hàng của bạn</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="fas fa-shopping-cart fa-3x mb-3 d-block text-muted"></i>
            <h4>Giỏ hàng trống</h4>
            <p>Hãy chọn thêm sản phẩm vào giỏ hàng để tiếp tục mua sắm.</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-2">
                <i class="fas fa-store"></i> Tiếp tục mua sắm
            </a>
        </div>
    }
    else
    {
        @* Nhóm sản phẩm theo danh mục *@
        @foreach (var group in grouped)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light font-weight-bold">
                    <i class="fas fa-folder me-2"></i> Danh mục: @group.Key
                    <span class="badge bg-primary ms-2">@group.Count() sản phẩm</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle mb-0">
                            <thead class="table-dark text-center">
                                <tr>
                                    <th style="width: 90px;">Hình ảnh</th>
                                    <th>Tên sản phẩm</th>
                                    <th style="width: 130px;">Đơn giá</th>
                                    <th style="width: 180px;">Số lượng</th>
                                    <th style="width: 140px;">Thành tiền</th>
                                    <th style="width: 100px;">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <img src="@ImgUrl(item.ProductImage, item.ProductID)" alt="@item.ProductName" style="width: 70px; height: 70px; object-fit: cover;" class="rounded" />
                                        </td>
                                        <td><strong>@item.ProductName</strong></td>
                                        <td class="text-end">@item.UnitPrice.ToString("N0") VNĐ</td>
                                        <td>
                                            @* Form cập nhật số lượng — POST tới Cart/UpdateQuantity *@
                                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post, new { @class = "d-flex align-items-center justify-content-center" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.ProductID" />
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm text-center me-1" style="width: 70px;" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Cập nhật số lượng">
                                                    <i class="fas fa-sync-alt"></i>
                                                </button>
                                            }
                                        </td>
                                        <td class="text-end text-danger fw-bold">@item.TotalPrice.ToString("N0") VNĐ</td>
                                        <td class="text-center">
                                            @* Nút Xóa — POST tới Cart/RemoveFromCart *@
                                            @using (Html.BeginForm("RemoveFromCart", "Cart", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.ProductID" />
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                                    <i class="fas fa-trash-alt"></i> Xóa
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        @* Tổng tiền + nút thao tác *@
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <span class="fw-bold fs-5">Tổng tiền thanh toán:</span>
                    <span class="text-danger fw-bold fs-5 ms-2">@totalAmount.ToString("N0") VNĐ</span>
                </div>
                <div class="d-flex gap-2">
                    @* Nút Xóa toàn bộ giỏ — POST tới Cart/ClearCart *@
                    @using (Html.BeginForm("ClearCart", "Cart", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Xóa toàn bộ giỏ hàng?');">
                            <i class="fas fa-trash me-1"></i> Xóa hết
                        </button>
                    }
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-primary">
                        <i class="fas fa-arrow-left"></i> Tiếp tục mua
                    </a>
                    <a href="@Url.Action("Checkout", "Order")" class="btn btn-success btn-lg">
                        Thanh toán <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    }

    @* Partial gợi ý sản phẩm tương tự (ẩn nếu không có dữ liệu) *@
    @Html.Partial("_PVSimilarProduct")
</div>
