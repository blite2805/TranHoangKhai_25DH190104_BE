@* Partial: gợi ý sản phẩm tương tự trên trang giỏ hàng.
   Lấy từ ViewBag.SimilarProducts (List<Product>). Nếu không có dữ liệu thì ẩn (không render gì). *@
@{
    var similar = ViewBag.SimilarProducts as List<_25DH190104_TranHoangKhai_BE.Models.Product>;
    string ImgUrl(string productImage, int productId)
    {
        if (string.IsNullOrEmpty(productImage)) return Url.Content("~/Content/Images/shopping.webp");
        if (productImage.StartsWith("http")) return productImage;
        return Url.Content("~/Content/Images/" + productImage);
    }
}
@if (similar != null && similar.Any())
{
    <div class="mt-5">
        <h4 class="mb-4 font-weight-bold border-bottom pb-2"><i class="fas fa-lightbulb me-2 text-warning"></i> Sản phẩm bạn có thể thích</h4>
        <div class="row">
            @foreach (var item in similar.Take(4))
            {
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm border rounded bg-white">
                        <div class="text-center p-3 bg-light border-bottom">
                            <img src="@ImgUrl(item.ProductImage, item.ProductID)" class="card-img-top" alt="@item.ProductName" style="height: 150px; object-fit: contain;" />
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-truncate fw-bold text-dark mb-1" title="@item.ProductName">@item.ProductName</h6>
                            <p class="card-text text-primary fw-bold mt-auto">@Convert.ToDecimal(item.ProductPrice).ToString("N0") VNĐ</p>
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
