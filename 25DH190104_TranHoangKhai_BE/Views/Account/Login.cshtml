@model _25DH190104_TranHoangKhai_BE.Models.LoginVM
@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
@* Hiển thị lỗi tổng qua @Html.ValidationSummary (controller AddModelError("", "Sai tên đăng nhập hoặc mật khẩu")) *@
<div class="container my-5">
    <div class="row justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="col-md-6 col-lg-4" style="max-width: 450px; margin: 0 auto;">
            <div class="card shadow border-0 rounded-lg">
                <div class="card-header text-white text-center py-3" style="background-color: #007bff !important;">
                    <h4 class="mb-0 font-weight-bold">
                        <i class="fas fa-sign-in-alt me-1"></i> ĐĂNG NHẬP HỆ THỐNG
                    </h4>
                </div>
                <div class="card-body p-4 bg-white">
                    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3 small" })

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Username, "Tên đăng nhập:", new { @class = "font-weight-bold text-dark mb-1" })
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Nhập tên đăng nhập...", style = "height: 42px;" })
                            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                        </div>
                        <div class="form-group mb-4">
                            @Html.LabelFor(m => m.Password, "Mật khẩu:", new { @class = "font-weight-bold text-dark mb-1" })
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Nhập mật khẩu...", style = "height: 42px;" })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary w-100 py-2 font-weight-bold shadow-sm" style="background-color: #007bff; border: none; font-size: 16px;">
                                <i class="fas fa-sign-in-alt me-1"></i> Đăng nhập
                            </button>
                        </div>
                    }
                    <div class="text-center mt-3">
                        <span class="text-muted">Chưa có tài khoản?</span>
                        @Html.ActionLink("Đăng ký ngay", "Register", "Account", null, new { @class = "text-primary font-weight-bold text-decoration-none" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
