@model List<_25DH190104_TranHoangKhai_BE.Models.Product>
@* Partial: Sản phẩm liên quan (RelatedProducts) — hiển thị trên trang ProductDetail. Nếu rỗng thì ẩn section. *@
@{
    string ImgUrl(string productImage, int productId)
    {
        if (string.IsNullOrEmpty(productImage)) return Url.Content("~/Content/Images/shopping.webp");
        if (productImage.StartsWith("http")) return productImage;
        return Url.Content("~/Content/Images/" + productImage);
    }
}
@if (Model != null && Model.Any())
{
    <h4 class="mb-4 font-weight-bold text-primary border-bottom pb-2"><i class="fas fa-related me-2"></i> Sản phẩm liên quan</h4>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 col-sm-6 mb-4">
                <div class="card product-card h-100 shadow-sm">
                    <div class="product-img-wrap text-center p-3 bg-light border-bottom">
                        <img src="@ImgUrl(item.ProductImage, item.ProductID)" class="card-img-top product-img" alt="@item.ProductName" />
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h6 class="product-name text-truncate font-weight-bold mb-1">@item.ProductName</h6>
                        <p class="product-price text-danger font-weight-bold mt-auto">@Convert.ToDecimal(item.ProductPrice).ToString("N0") VNĐ</p>
                        <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-outline-primary btn-sm">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
