@model _25DH190104_TranHoangKhai_BE.Models.ProductDetailVM
@{
    ViewBag.Title = Model != null && Model.Product != null ? Model.Product.ProductName : "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var product = Model != null ? Model.Product : null;
    string ImgUrl(string productImage, int productId)
    {
        if (string.IsNullOrEmpty(productImage)) return Url.Content("~/Content/Images/shopping.webp");
        if (productImage.StartsWith("http")) return productImage;
        return Url.Content("~/Content/Images/" + productImage);
    }
}
@* ProductDetail: model ProductDetailVM (Product + RelatedProducts + TopProducts).
   Form POST tới Home/ProductDetail với quantity hidden id + input quantity + nút Thêm vào giỏ.
   Render _PVRelatedProduct + _PVTopProduct. *@
<div class="container mt-4 mb-5">
    @if (product == null)
    {
        <div class="alert alert-warning text-center py-5">Không có dữ liệu</div>
    }
    else
    {
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-light p-3 rounded">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("ProductList", "Home")">Sản phẩm</a></li>
                <li class="breadcrumb-item active" aria-current="page">@product.ProductName</li>
            </ol>
        </nav>

        <div class="row mt-4 detail-product-row">
            <!-- Ảnh sản phẩm -->
            <div class="col-md-5 mb-4 text-center">
                <div class="detail-img-box border rounded p-3 shadow-sm bg-white">
                    <img src="@ImgUrl(product.ProductImage, product.ProductID)" alt="@product.ProductName" class="img-fluid rounded detail-product-img" />
                </div>
            </div>
            <!-- Thông tin chi tiết -->
            <div class="col-md-7 detail-info-col">
                <h2 class="font-weight-bold text-dark detail-product-name">@product.ProductName</h2>
                <hr />
                <h3 class="text-danger font-weight-bold mb-3 detail-product-price">
                    @Convert.ToDecimal(product.ProductPrice).ToString("N0") VNĐ
                </h3>
                <p class="text-muted">
                    <strong>Danh mục:</strong> @(product.Category != null ? product.Category.CategoryName : "—")
                    <span class="mx-2">|</span>
                    <strong>Trạng thái:</strong> <span class="badge bg-success">Còn hàng</span>
                </p>
                <div class="mb-4">
                    <h5 class="font-weight-bold">Mô tả sản phẩm:</h5>
                    <p class="text-secondary detail-product-desc">
                        @(string.IsNullOrEmpty(product.ProductDescription) ? "Đang cập nhật thông tin chi tiết cho sản phẩm này." : product.ProductDescription)
                    </p>
                </div>

                <!-- Form Thêm vào giỏ hàng — POST tới Home/ProductDetail (theo spec Phần 3) -->
                @using (Html.BeginForm("ProductDetail", "Home", FormMethod.Post, new { @class = "form-inline" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@product.ProductID" />
                    <div class="d-flex align-items-center mb-4 flex-wrap gap-2">
                        <label class="me-3 font-weight-bold">Số lượng:</label>
                        <input type="number" name="quantity" value="1" min="1" class="form-control text-center me-3 detail-qty-input" />
                        <button type="submit" class="btn btn-warning text-white btn-lg font-weight-bold px-4 detail-add-btn">
                            <i class="fas fa-cart-plus me-2"></i> Thêm vào giỏ
                        </button>
                    </div>
                }
                <div class="mt-3">
                    <a href="@Url.Action("ProductList", "Home")" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách sản phẩm
                    </a>
                </div>
            </div>
        </div>

        <hr class="my-5" />

        <!-- Sản phẩm liên quan + Sản phẩm bán chạy -->
        <div class="mb-5">
            @Html.Partial("_PVRelatedProduct", Model.RelatedProducts)
        </div>
        <div class="mb-5">
            @Html.Partial("_PVTopProduct", Model.TopProducts)
        </div>
    }
</div>
