@model _25DH190104_TranHoangKhai_BE.Models.HomeProductVM
@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
@* Home/Index: model HomeProductVM (FeaturedProducts + NewProducts).
   Render _PVFeatureProduct cho FeaturedProducts, _PVNewProduct cho NewProducts (có phân trang).
   Ô tìm kiếm searchTerm form GET. Rỗng → "Không có dữ liệu". *@

<!-- 1. BANNER TRANG CHỦ — dùng ảnh banner_home.jpg có sẵn, giữ overlay text + nút CTA -->
<div class="home-banner position-relative text-white text-center mb-5 w-100" style="background-image: url('@Url.Content("~/Content/Images/banner_home.jpg")');">
    <div class="position-absolute w-100 h-100 d-flex flex-column justify-content-center align-items-center home-banner-overlay">
        <h1 class="fw-bold display-5 mb-2">Chào mừng đến với KHARI Store</h1>
        <p class="lead mb-4">Mua sắm trực tuyến với hàng ngàn sản phẩm đa dạng và chất lượng</p>
        <a href="@Url.Action("ProductList", "Home")" class="btn home-cta-btn text-white fw-bold px-4 py-2 shadow">
            Bắt đầu mua sắm
        </a>
    </div>
</div>

<div class="container mb-5">
    <!-- THANH TÌM KIẾM TRUNG TÂM (form GET) -->
    <div class="text-center mb-5">
        <h2 class="fw-bold mb-3 home-section-title">Tìm kiếm sản phẩm</h2>
        <div class="home-search-box">
            @using (Html.BeginForm("Index", "Home", FormMethod.Get))
            {
                <div class="home-search-inner">
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="home-search-input" placeholder="Nhập tên sản phẩm cần tìm..." />
                    <button type="submit" class="home-search-btn"><i class="fas fa-search me-1"></i> Tìm kiếm</button>
                </div>
            }
        </div>
    </div>

    <!-- SẢN PHẨM NỔI BẬT -->
    <section class="mb-5">
        <h3 class="fw-bold text-dark border-bottom pb-2 mb-4">
            <i class="fas fa-star text-warning me-2"></i> Sản phẩm nổi bật
        </h3>
        @if (Model == null || Model.FeaturedProducts == null || !Model.FeaturedProducts.Any())
        {
            <div class="alert alert-warning text-center py-4" role="alert">Không có dữ liệu</div>
        }
        else
        {
            @Html.Partial("_PVFeatureProduct", Model.FeaturedProducts)
        }
    </section>

    <!-- SẢN PHẨM MỚI (có phân trang) -->
    <section id="new-products" class="mb-5">
        <h3 class="fw-bold text-dark border-bottom pb-2 mb-4">
            <i class="fas fa-sparkles text-info me-2"></i> Sản phẩm mới
        </h3>
        @if (Model == null || Model.NewProducts == null || !Model.NewProducts.Any())
        {
            <div class="alert alert-warning text-center py-4" role="alert">Không có dữ liệu</div>
        }
        else
        {
            @Html.Partial("_PVNewProduct", Model.NewProducts)
        }
    </section>
</div>
