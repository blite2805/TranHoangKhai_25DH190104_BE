@model _25DH190104_TranHoangKhai_BE.Models.CheckoutVM
@{
    ViewBag.Title = "Thanh toán";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}
@* Checkout: model CheckoutVM. Hiển thị danh sách sản phẩm + tổng tiền.
   Form POST tới Order/Checkout. ShippingAddress mặc định readonly, nút "Chỉnh sửa" (id=enableAddressEdit) bật/tắt bằng JS.
   Dropdown DeliveryMethod (Giao hàng tận nơi / Nhận tại cửa hàng), PaymentMethod (COD / Chuyển khoản). *@
<div class="container mt-4 mb-5" style="max-width: 900px;">
    <h2 class="mb-4 font-weight-normal text-secondary"><i class="fas fa-credit-card me-2"></i> Thông tin thanh toán</h2>

    @* Danh sách sản phẩm trong đơn *@
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light font-weight-bold"><i class="fas fa-shopping-bag me-2"></i> Sản phẩm đã chọn</div>
        <div class="card-body p-0">
            @if (Model.Items != null && Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead class="table-light text-center">
                            <tr>
                                <th>Hình ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-center">
                                        <img src="@Url.Content(string.IsNullOrEmpty(item.ProductImage) ? "~/Content/Images/shopping.webp" : (item.ProductImage.StartsWith("http") ? item.ProductImage : "~/Content/Images/" + item.ProductImage))"
                                             alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: cover;" class="rounded" />
                                    </td>
                                    <td><strong>@item.ProductName</strong></td>
                                    <td class="text-end">@item.UnitPrice.ToString("N0") VNĐ</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end text-danger fw-bold">@item.TotalPrice.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-warning m-3 mb-0 text-center">Giỏ hàng trống — không thể thanh toán.</div>
            }
        </div>
    </div>

    @using (Html.BeginForm("Checkout", "Order", FormMethod.Post, new { @class = "card shadow-sm" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger m-3 mb-0 small" })
        <div class="card-body">
            <h6 class="border-bottom pb-2 mb-3 font-weight-bold"><i class="fas fa-user me-1"></i> Thông tin nhận hàng</h6>
            <div class="row mb-3">
                <div class="col-md-6 mb-2">
                    <label class="font-weight-bold">Người nhận</label>
                    <input type="text" class="form-control bg-light" value="@Model.CustomerName" readonly />
                </div>
                <div class="col-md-3 mb-2">
                    <label class="font-weight-bold">SĐT</label>
                    <input type="text" class="form-control bg-light" value="@Model.CustomerPhone" readonly />
                </div>
                <div class="col-md-3 mb-2">
                    <label class="font-weight-bold">Email</label>
                    <input type="text" class="form-control bg-light" value="@Model.CustomerEmail" readonly />
                </div>
            </div>

            @* Địa chỉ giao hàng: mặc định readonly, nút Chỉnh sửa bật/tắt (id=enableAddressEdit) *@
            <div class="form-group mb-3">
                <label class="font-weight-bold">Địa chỉ giao hàng</label>
                <div class="input-group">
                    @Html.TextBoxFor(m => m.ShippingAddress, new { @class = "form-control bg-light", @readonly = "readonly", id = "shippingAddressInput" })
                    <button type="button" class="btn btn-outline-secondary" id="enableAddressEdit">
                        <i class="fas fa-edit me-1"></i> Chỉnh sửa
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.ShippingAddress, "", new { @class = "text-danger small" })
                <small class="form-text text-muted">Mặc định lấy từ địa chỉ khách hàng. Bấm "Chỉnh sửa" để sửa.</small>
            </div>

            @* Dropdown Phương thức giao hàng *@
            <div class="form-group mb-3">
                @Html.LabelFor(m => m.DeliveryMethod, "Phương thức giao hàng", new { @class = "font-weight-bold" })
                @Html.DropDownListFor(m => m.DeliveryMethod, new SelectList(new[] { "Giao hàng tận nơi", "Nhận tại cửa hàng" }), "--- Chọn phương thức giao hàng ---", new { @class = "form-select form-control" })
                @Html.ValidationMessageFor(m => m.DeliveryMethod, "", new { @class = "text-danger small" })
            </div>

            @* Dropdown Phương thức thanh toán *@
            <div class="form-group mb-4">
                @Html.LabelFor(m => m.PaymentMethod, "Phương thức thanh toán", new { @class = "font-weight-bold" })
                @Html.DropDownListFor(m => m.PaymentMethod, new SelectList(new[] { "COD (Thanh toán khi nhận hàng)", "Chuyển khoản" }), "--- Chọn phương thức thanh toán ---", new { @class = "form-select form-control" })
                @Html.ValidationMessageFor(m => m.PaymentMethod, "", new { @class = "text-danger small" })
            </div>

            <div class="d-flex justify-content-between align-items-center border-top pt-3">
                <div>
                    <span class="font-weight-bold fs-5">Tổng tiền:</span>
                    <span class="text-danger fw-bold fs-5 ms-2">@Model.TotalAmount.ToString("N0") VNĐ</span>
                </div>
                <button type="submit" class="btn btn-success btn-lg px-4">
                    <i class="fas fa-check-circle me-1"></i> Đặt hàng
                </button>
            </div>
        </div>
    }
</div>

@section scripts {
    <script>
        // Nút "Chỉnh sửa" bật/tắt readonly cho ô địa chỉ giao hàng
        document.getElementById("enableAddressEdit").addEventListener("click", function () {
            var input = document.getElementById("shippingAddressInput");
            if (input.hasAttribute("readonly")) {
                input.removeAttribute("readonly");
                input.classList.remove("bg-light");
                input.focus();
                input.select();
                this.innerHTML = '<i class="fas fa-lock me-1"></i> Khóa';
            } else {
                input.setAttribute("readonly", "readonly");
                input.classList.add("bg-light");
                this.innerHTML = '<i class="fas fa-edit me-1"></i> Chỉnh sửa';
            }
        });
    </script>
}
