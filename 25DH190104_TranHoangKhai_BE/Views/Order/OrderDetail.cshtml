@model IEnumerable<_25DH190104_TranHoangKhai_BE.Models.OrderDetail>
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var order = ViewBag.Order as _25DH190104_TranHoangKhai_BE.Models.Order;
}
@* OrderDetail: chi tiết đơn hàng (ViewBag.Order) + danh sách OrderDetail (Model). *@
<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="fas fa-file-invoice me-2"></i> Chi tiết đơn hàng #@(order != null ? order.OrderID : 0)</h3>
        <a href="@Url.Action("MyOrder", "Order")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    @if (order != null)
    {
        <div class="card mb-4 bg-light shadow-sm">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Ngày đặt hàng:</strong> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                        <p class="mb-1"><strong>Địa chỉ giao hàng:</strong> @order.ShippingAddress</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Phương thức giao hàng:</strong> @(string.IsNullOrEmpty(order.DeliveryMethod) ? "—" : order.DeliveryMethod)</p>
                        <p class="mb-1"><strong>Phương thức thanh toán:</strong> @(string.IsNullOrEmpty(order.PaymentMethod) ? "—" : order.PaymentMethod)</p>
                        <p class="mb-1"><strong>Trạng thái:</strong>
                            @if (order.PaymentStatus == "Đã thanh toán")
                            {
                                <span class="badge bg-success">@order.PaymentStatus</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@(string.IsNullOrEmpty(order.PaymentStatus) ? "Chưa thanh toán" : order.PaymentStatus)</span>
                            }
                        </p>
                    </div>
                </div>
                <hr />
                <p class="mb-0"><strong>Tổng tiền thanh toán:</strong> <span class="text-danger font-weight-bold fs-5">@order.TotalAmount.ToString("N0") VNĐ</span></p>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-light font-weight-bold"><i class="fas fa-list me-2"></i> Sản phẩm trong đơn hàng</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-secondary text-center">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var detail in Model)
                            {
                                <tr>
                                    <td>@(detail.Product != null ? detail.Product.ProductName : "Mã SP: " + detail.ProductID)</td>
                                    <td class="text-center">@detail.Quantity</td>
                                    <td class="text-end">@detail.UnitPrice.ToString("N0") VNĐ</td>
                                    <td class="text-end text-danger font-weight-bold">
                                        @* TotalPrice là computed column PERSISTED; nếu chưa có thì tính tay *@
                                        @(detail.TotalPrice > 0 ? detail.TotalPrice.ToString("N0") : (detail.Quantity * detail.UnitPrice).ToString("N0")) VNĐ
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Không có dữ liệu</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
