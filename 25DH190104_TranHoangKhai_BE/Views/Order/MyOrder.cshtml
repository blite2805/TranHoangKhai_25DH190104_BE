@model IEnumerable<_25DH190104_TranHoangKhai_BE.Models.Order>
@{
    ViewBag.Title = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    string currentStatus = ViewBag.CurrentStatus as string ?? "";
    string currentSearch = ViewBag.SearchTerm as string ?? "";
    string[] tabs = { "", "Chưa thanh toán", "Đã thanh toán", "Đã hủy" };
    string[] tabLabels = { "Tất cả", "Chưa thanh toán", "Đã thanh toán", "Đã hủy" };
}
@* MyOrder: tab lọc theo status (Tất cả/Chưa thanh toán/Đã thanh toán/Đã hủy) + ô tìm kiếm searchTerm (GET).
   Link tới Order/OrderDetail. Rỗng → "Không có dữ liệu". *@
<div class="container mt-4 mb-5">
    <h3 class="mb-4"><i class="fas fa-history me-2"></i> Lịch sử mua hàng</h3>

    @* Ô tìm kiếm (form GET) *@
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("MyOrder", "Order", FormMethod.Get))
            {
                <div class="input-group" style="max-width: 500px;">
                    <input type="text" name="searchTerm" value="@currentSearch" class="form-control" placeholder="Tìm theo mã đơn hoặc địa chỉ..." />
                    <button type="submit" class="btn btn-primary"><i class="fas fa-search me-1"></i> Tìm</button>
                </div>
            }
        </div>
    </div>

    @* Tab lọc theo trạng thái *@
    <ul class="nav nav-pills mb-4">
        @for (int i = 0; i < tabs.Length; i++)
        {
            var active = (currentStatus == tabs[i]) ? "active" : "";
            <li class="nav-item">
                <a class="nav-link @active" href="@Url.Action("MyOrder", "Order", new { status = tabs[i], searchTerm = currentSearch })">
                    @tabLabels[i]
                </a>
            </li>
        }
    </ul>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center py-4" role="alert">
            <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
            <h5 class="mb-1">Không có dữ liệu</h5>
            <p class="mb-0">Không tìm thấy đơn hàng nào phù hợp.</p>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>Mã đơn hàng</th>
                        <th>Ngày đặt</th>
                        <th>Địa chỉ giao hàng</th>
                        <th>Trạng thái</th>
                        <th>Tổng tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center font-weight-bold">#@item.OrderID</td>
                            <td class="text-center">@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.ShippingAddress</td>
                            <td class="text-center">
                                @if (item.PaymentStatus == "Đã thanh toán")
                                {
                                    <span class="badge bg-success">@item.PaymentStatus</span>
                                }
                                else if (item.PaymentStatus == "Đã hủy")
                                {
                                    <span class="badge bg-secondary">@item.PaymentStatus</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">@(string.IsNullOrEmpty(item.PaymentStatus) ? "Chưa thanh toán" : item.PaymentStatus)</span>
                                }
                            </td>
                            <td class="text-end text-danger font-weight-bold">@item.TotalAmount.ToString("N0") VNĐ</td>
                            <td class="text-center">
                                <a href="@Url.Action("OrderDetail", "Order", new { id = item.OrderID })" class="btn btn-sm btn-info text-white">
                                    <i class="fas fa-eye me-1"></i> Xem chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
