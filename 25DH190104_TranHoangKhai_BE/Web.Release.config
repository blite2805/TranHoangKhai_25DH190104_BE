<?xml version="1.0" encoding="utf-8"?>

<!-- For more information on using web.config transformation visit https://go.microsoft.com/fwlink/?LinkId=125889 -->

<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    TRIỂN KHAI LÊN PRODUCTION (Azure App Service / hosting):
    Cách 1 (KHẤN NGHỊ, không lộ mật khẩu trong source): trên Azure Portal
      App Service → Settings → Configuration → Connection strings → New connection string:
        Name: MyStoreEntities
        Type: Custom   (QUAN TRỌNG: vì đây là EF Database-First EntityClient, không phải SQL Server thường)
        Value: metadata=res://*/Models.MyStoreModel.csdl|res://*/Models.MyStoreModel.ssdl|res://*/Models.MyStoreModel.msl;
               provider=System.Data.SqlClient;
               provider connection string="data source=<TEN-SERVER>.database.windows.net;initial catalog=<TEN-DB>;
               user id=<USER>;password=<PASSWORD>;trustservercertificate=True;
               MultipleActiveResultSets=True;App=EntityFramework"
      Azure sẽ tự đè connection string này lên Web.config lúc runtime — KHÔNG cần sửa gì trong file này.

    Cách 2: điền trực tiếp vào placeholder __AZURE_SQL_*__ bên dưới.
      LƯU Ý: nếu điền mật khẩu thật vào file này thì MẬT KHẨU SẼ BỊ COMMIT LÊN GITHUB.
      Chỉ dùng cách 2 khi repo private, hoặc xóa ngay sau khi publish.
  -->
  <connectionStrings>
    <add name="MyStoreEntities"
         connectionString="metadata=res://*/Models.MyStoreModel.csdl|res://*/Models.MyStoreModel.ssdl|res://*/Models.MyStoreModel.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=__AZURE_SQL_SERVER__.database.windows.net;initial catalog=__AZURE_SQL_DB__;user id=__AZURE_SQL_USER__;password=__AZURE_SQL_PASSWORD__;trustservercertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;"
         providerName="System.Data.EntityClient"
         xdt:Transform="SetAttributes(connectionString)" xdt:Locator="Match(name)" />
  </connectionStrings>

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!-- Tắt hiển thị lỗi chi tiết ra ngoài (bảo mật production) -->
    <customErrors mode="RemoteOnly" xdt:Transform="Insert" />
  </system.web>
</configuration>
