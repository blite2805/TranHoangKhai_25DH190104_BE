<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile cho Azure App Service (Windows, .NET Framework 4.7.2).
  CÁCH DÙNG:
  1. Thay __TEN-WEBAPP__ bằng tên App Service đã tạo trên Azure (vd: kharistore).
     MSDeployServiceURL sẽ là https://__TEN-WEBAPP__.scm.azurewebsites.net:443/msdeploy.axd?site=__TEN-WEBAPP__
  2. Khi publish từ Visual Studio: chuột phải project → Publish → chọn profile "AzureWebApp" → nhập Password
     (lấy từ Azure Portal → App Service → Get publish profile → trường userPWD của <publishProfile publishMethod="MSDeploy">).
  3. Khi publish bằng GitHub Actions: password được truyền qua biến $(Password) từ secret AZURE_WEBAPP_PUBLISH_PROFILE,
     KHÔNG lưu mật khẩu vào file này.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LaunchSiteAfterPublish>True</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://__TEN-WEBAPP__.azurewebsites.net</SiteUrlToLaunchAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <MSDeployServiceURL>https://__TEN-WEBAPP__.scm.azurewebsites.net:443/msdeploy.axd?site=__TEN-WEBAPP__</MSDeployServiceURL>
    <DeployIisAppPath>__TEN-WEBAPP__</DeployIisAppPath>
    <RemoteSitePhysicalPath />
    <SkipExtraFilesOnServer>True</SkipExtraFilesOnServer>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>True</EnableMSDeployBackup>
    <UserName>$__TEN-WEBAPP__</UserName>
    <_SavePWD>False</_SavePWD>
    <_DestinationType>AzureWebSite</_DestinationType>
    <InstallAspNetCorePlatformHandler>False</InstallAspNetCorePlatformHandler>
    <AllowUntrustedCertificate>True</AllowUntrustedCertificate>
  </PropertyGroup>
</Project>
